# Server
PORT=3001
NODE_ENV=development

# CORS - Frontend URL
FRONTEND_URL="http://localhost:5173"

# Admin User (created on first seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
ADMIN_FULLNAME="مدير النظام"

# AI Assistant (Gemini)
GEMINI_API_KEY=
