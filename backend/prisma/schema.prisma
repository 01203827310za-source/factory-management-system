// ============================================
// Prisma Schema - Clothing Factory Management
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== USERS & AUTH =====
enum Role {
  admin    // كل الصلاحيات + إدارة المستخدمين
  manager  // كل العمليات بدون إدارة المستخدمين
  viewer   // قراءة فقط
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  full_name  String
  role       Role     @default(viewer)
  is_active  Boolean  @default(true)
  last_login DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("users")
}

// ===== SALES =====
model Sale {
  id                 Int      @id @default(autoincrement())
  order_number       String
  row_number         Int      @default(0)
  marketer           String   @default("")
  client             String
  model1_code        String   @default("")
  model1_qty         Int      @default(0)
  model1_color       String   @default("")
  model2_code        String   @default("")
  model2_qty         Int      @default(0)
  model2_color       String   @default("")
  model3_code        String   @default("")
  model3_qty         Int      @default(0)
  model3_color       String   @default("")
  model4_code        String   @default("")
  model4_qty         Int      @default(0)
  model4_color       String   @default("")
  model5_code        String   @default("")
  model5_qty         Int      @default(0)
  model5_color       String   @default("")
  invoice_value      Float    @default(0)
  deposit_paid       Float    @default(0)
  deposit_receiver   String   @default("")
  remaining          Float    @default(0)
  shipping_number    String   @default("")
  order_status       String   @default("لم يتم الصرف")
  delivery_method    String   @default("")
  mobile             String   @default("")
  warehouse          String   @default("")
  shipping_collected Float    @default(0)
  created_at         DateTime @default(now())

  @@map("sales")
}

// ===== EXPENSES & REVENUES =====
model ExpenseRevenue {
  id             Int      @id @default(autoincrement())
  date           String
  operation_type String
  statement      String
  hatem_in       Float    @default(0)
  hatem_out      Float    @default(0)
  mido_in        Float    @default(0)
  mido_out       Float    @default(0)
  created_at     DateTime @default(now())

  @@map("expenses_revenues")
}

// ===== READY STOCK =====
model ReadyStock {
  id                Int    @id @default(autoincrement())
  model_code        String
  product_name      String
  color             String @default("")
  opening_balance   Int    @default(0)
  cost_per_piece    Float  @default(0)
  location          String @default("")
  mido_stock        Int    @default(0)
  hatem_stock       Int    @default(0)
  reserved_quantity Int    @default(0)

  @@map("ready_stock")
}

// ===== FABRIC WAREHOUSE =====
model FabricWarehouse {
  id            Int      @id @default(autoincrement())
  date          String
  material_type String
  color         String   @default("")
  qty_in        Float    @default(0)
  cost_per_kg   Float    @default(0)
  created_at    DateTime @default(now())

  @@map("fabric_warehouse")
}

// ===== ACCESSORIES WAREHOUSE =====
model AccessoriesWarehouse {
  id           Int      @id @default(autoincrement())
  date         String
  item_name    String
  qty_in       Float    @default(0)
  qty_consumed Float    @default(0)
  cost         Float    @default(0)
  created_at   DateTime @default(now())

  @@map("accessories_warehouse")
}

// ===== CUTTING ORDERS =====
model CuttingOrder {
  id              Int      @id @default(autoincrement())
  date            String
  cut_number      Int
  cut_description String   @default("")
  material_type   String
  layers_count    Int      @default(0)
  spread_length_m Float    @default(0)
  total_pieces    Int      @default(0)
  color           String   @default("")
  kg_consumed     Float    @default(0)
  notes           String   @default("")
  created_at      DateTime @default(now())

  @@map("cutting_orders")
}

// ===== MODEL PRODUCTION =====
model ModelProduction {
  id                   Int      @id @default(autoincrement())
  date                 String
  cut_number           Int
  model_code           String
  qty_from_cutting     Int      @default(0)
  model_description    String   @default("")
  color                String   @default("")
  sizes                String   @default("")
  status               String   @default("قيد التشغيل")
  wastage              Int      @default(0)
  qty_received         Int      @default(0)
  warehouse_entry_date String   @default("")
  created_at           DateTime @default(now())

  @@map("model_productions")
}

// ===== DEBTS =====
model Debt {
  id           Int      @id @default(autoincrement())
  date         String
  name         String
  total_amount Float    @default(0)
  amount_paid  Float    @default(0)
  remaining    Float    @default(0)
  created_at   DateTime @default(now())

  @@map("debts")
}

// ===== CLIENT ACCOUNTS =====
model ClientAccount {
  id           Int      @id @default(autoincrement())
  date         String
  client_name  String
  model_name   String   @default("")
  quantity     Int      @default(0)
  total_amount Float    @default(0)
  amount_paid  Float    @default(0)
  remaining    Float    @default(0)
  notes        String   @default("")
  created_at   DateTime @default(now())

  @@map("client_accounts")
}

// ===== RETURNS =====
model ReturnItem {
  id            Int      @id @default(autoincrement())
  date          String
  order_number  String   @default("")
  client_name   String
  returned_by   String   @default("")
  paid_by       String   @default("")
  model_code    String   @default("")
  model_qty     Int      @default(0)
  model_color   String   @default("")
  refund_amount Float    @default(0)
  notes         String   @default("")
  created_at    DateTime @default(now())

  @@map("return_items")
}

// ===== PAYMENT LOGS =====
model PaymentLog {
  id          Int      @id @default(autoincrement())
  date        String
  type        String
  amount      Float    @default(0)
  receiver    String   @default("")
  description String   @default("")
  created_at  DateTime @default(now())

  @@map("payment_logs")
}

// ===== MARKETERS (moved from localStorage to DB) =====
model Marketer {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now())

  @@map("marketers")
}
model Asset {
  id         Int      @id @default(autoincrement())
  name       String
  value      Float
  notes      String?
  created_at DateTime @default(now())

  @@map("assets")
}

// ===== FIXED ASSETS =====
model FixedAsset {
  id                Int      @id @default(autoincrement())
  name              String
  category          String   @default("")
  purchase_date     String
  purchase_price    Float    @default(0)
  useful_life_years Int      @default(1)
  notes             String   @default("")
  created_at        DateTime @default(now())

  @@map("fixed_assets")
}