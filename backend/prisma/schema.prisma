// ============================================
// Prisma Schema - Clothing Factory Management
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== USERS & AUTH =====
enum LegacyRole {
  admin    // كل الصلاحيات + إدارة المستخدمين
  manager  // كل العمليات بدون إدارة المستخدمين
  viewer   // قراءة فقط
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  full_name  String
  role       String   @default("viewer")
  role_id    Int?
  role_ref   Role?    @relation(fields: [role_id], references: [id], onDelete: SetNull)
  is_active  Boolean  @default(true)
  last_login DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user_permissions UserPermission[]

  @@map("users")
}

model Role {
  id               Int              @id @default(autoincrement())
  name             String           @unique
  display_name     String
  description      String           @default("")
  is_system        Boolean          @default(true)
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  users            User[]
  role_permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id               Int              @id @default(autoincrement())
  key              String           @unique
  module           String
  action           String
  label            String
  created_at       DateTime         @default(now())
  role_permissions RolePermission[]
  user_permissions UserPermission[]

  @@map("permissions")
}

// ===== SEASONS =====
model Season {
  id          Int      @id @default(autoincrement())
  name        String
  year        Int
  type        String   @default("")
  status      String   @default("inactive")
  is_active   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  sales                  Sale[]
  expenses_revenues      ExpenseRevenue[]
  charity_payments       CharityPayment[]
  shipping_collections   ShippingCollection[]
  inventory_movements    InventoryMovement[]
  order_cancellations    OrderCancellation[]
  cash_counts            CashCount[]
  cash_adjustments       CashAdjustment[]
  ready_stock            ReadyStock[]
  fabric_warehouse       FabricWarehouse[]
  fabric_purchases       FabricPurchase[]
  accessories_warehouse  AccessoriesWarehouse[]
  cutting_orders         CuttingOrder[]
  model_productions      ModelProduction[]
  model_parts            ModelPart[]
  debts                  Debt[]
  debt_payments          DebtPayment[]
  client_accounts        ClientAccount[]
  client_account_payments ClientAccountPayment[]
  client_account_invoices ClientAccountInvoice[]
  return_items           ReturnItem[]
  payment_logs           PaymentLog[]
  financial_snapshots    FinancialSnapshot[]
  print_orders           PrintOrder[]

  @@unique([name, year])
  @@map("seasons")
}

model RolePermission {
  id            Int        @id @default(autoincrement())
  role_id       Int
  permission_id Int
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

model UserPermission {
  id            Int        @id @default(autoincrement())
  user_id       Int
  permission_id Int
  allowed       Boolean    @default(true)
  user          User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([user_id, permission_id])
  @@map("user_permissions")
}

// ===== SALES =====
model Sale {
  id                 Int      @id @default(autoincrement())
  season_id          Int
  season             Season   @relation(fields: [season_id], references: [id])
  order_number       String
  row_number         Int      @default(0)
  marketer           String   @default("")
  client             String
  model1_code        String   @default("")
  model1_qty         Int      @default(0)
  model1_color       String   @default("")
  model2_code        String   @default("")
  model2_qty         Int      @default(0)
  model2_color       String   @default("")
  model3_code        String   @default("")
  model3_qty         Int      @default(0)
  model3_color       String   @default("")
  model4_code        String   @default("")
  model4_qty         Int      @default(0)
  model4_color       String   @default("")
  model5_code        String   @default("")
  model5_qty         Int      @default(0)
  model5_color       String   @default("")
  invoice_value      Float    @default(0)
  deposit_paid       Float    @default(0)
  deposit_receiver   String   @default("")
  remaining          Float    @default(0)
  shipping_number    String   @default("")
  order_status       String   @default("لم يتم الصرف")
  delivery_method    String   @default("")
  mobile             String   @default("")
  warehouse          String   @default("")
  shipping_collected Float    @default(0)
  // Calendar day (YYYY-MM-DD, Africa/Cairo) the shipping company's payout was confirmed.
  // NULL for orders dispatched before this column existed — never back-filled/invented.
  shipping_collected_date String?
  created_at         DateTime @default(now())
  // Set only when a SHIPPED order is cancelled: what happened to the goods.
  //   returned_resalable → back in sellable stock · not_returned → still with the customer / shipping company
  //   returned_damaged   → back in the building but not sellable (inspection)
  // NULL for never-shipped cancellations and for orders cancelled before this column existed.
  cancel_disposition String?
  // Cancellation of a shipped order, per order line: pieces that are STILL OUTSIDE the sellable stock
  // (not returned / damaged). NULL = the order was cancelled before this column existed (the whole-order
  // disposition then decides, and the shipped cost was fully reversed). Non-NULL (all five set) = the
  // cost of exactly these pieces stays recognised until they come back resalable.
  model1_unreturned_qty Int?
  model2_unreturned_qty Int?
  model3_unreturned_qty Int?
  model4_unreturned_qty Int?
  model5_unreturned_qty Int?
  collections        ShippingCollection[]
  movements          InventoryMovement[]
  cancellations      OrderCancellation[]

  @@map("sales")
}

// ===== EXPENSES & REVENUES =====
model ExpenseRevenue {
  id             Int      @id @default(autoincrement())
  season_id      Int
  season         Season   @relation(fields: [season_id], references: [id])
  date           String
  operation_type String
  statement      String
  amount_in      Float    @default(0)
  amount_out     Float    @default(0)
  // Phase-2 drop: hatem_in, hatem_out, mido_in, mido_out kept in DB until verified
  hatem_in       Float    @default(0)
  hatem_out      Float    @default(0)
  mido_in        Float    @default(0)
  mido_out       Float    @default(0)
  created_at     DateTime @default(now())
  charity_payment CharityPayment?

  @@map("expenses_revenues")
}

// ===== READY STOCK =====
model ReadyStock {
  id                Int    @id @default(autoincrement())
  season_id         Int
  season            Season @relation(fields: [season_id], references: [id])
  model_code        String
  product_name      String
  color             String @default("")
  opening_balance   Int    @default(0)
  cost_per_piece    Float  @default(0)
  location          String @default("")
  reserved_quantity Int    @default(0)

  @@map("ready_stock")
}

// ===== FABRIC WAREHOUSE =====
model FabricWarehouse {
  id                  Int      @id @default(autoincrement())
  season_id           Int
  season              Season   @relation(fields: [season_id], references: [id])
  date                String
  material_type       String
  color               String   @default("")
  qty_in              Float    @default(0)
  cost_per_kg         Float    @default(0)
  avg_cost_per_kg     Float    @default(0)
  last_purchase_price Float    @default(0)
  created_at          DateTime @default(now())

  @@map("fabric_warehouse")
}

// ===== FABRIC PURCHASES =====
model FabricPurchase {
  id           Int      @id @default(autoincrement())
  season_id    Int
  season       Season   @relation(fields: [season_id], references: [id])
  date         String
  fabric_type  String
  color        String   @default("")
  quantity_kg  Float    @default(0)
  price_per_kg Float    @default(0)
  total_cost   Float    @default(0)
  supplier     String   @default("")
  invoice_no   String   @default("")
  notes        String   @default("")
  created_at   DateTime @default(now())

  @@map("fabric_purchases")
}

// ===== ACCESSORIES WAREHOUSE =====
model AccessoriesWarehouse {
  id           Int      @id @default(autoincrement())
  season_id    Int
  season       Season   @relation(fields: [season_id], references: [id])
  date         String
  item_name    String
  qty_in       Float    @default(0)
  qty_consumed Float    @default(0)
  cost         Float    @default(0)
  created_at   DateTime @default(now())

  @@map("accessories_warehouse")
}

// ===== CUTTING ORDERS =====
model CuttingOrder {
  id              Int      @id @default(autoincrement())
  season_id       Int
  season          Season   @relation(fields: [season_id], references: [id])
  date            String
  cut_number      Int
  cut_description String   @default("")
  material_type   String
  layers_count    Int      @default(0)
  spread_length_m Float    @default(0)
  total_pieces    Int      @default(0)
  color           String   @default("")
  kg_consumed     Float    @default(0)
  cost_per_meter  Float    @default(0)
  notes           String   @default("")
  created_at      DateTime @default(now())

  @@map("cutting_orders")
}

// ===== MODEL PRODUCTION =====
model ModelProduction {
  id                   Int         @id @default(autoincrement())
  season_id            Int
  season               Season      @relation(fields: [season_id], references: [id])
  date                 String
  cut_number           Int
  model_code           String
  qty_from_cutting     Int         @default(0)
  model_description    String      @default("")
  color                String      @default("")
  sizes                String      @default("")
  status               String      @default("قيد التشغيل")
  wastage              Int         @default(0)
  qty_received         Int         @default(0)
  cost_per_piece       Float       @default(0)
  warehouse_entry_date String      @default("")
  created_at           DateTime    @default(now())
  parts                ModelPart[]

  @@map("model_productions")
}

// ===== MODEL PARTS =====
model ModelPart {
  id         Int             @id @default(autoincrement())
  season_id  Int
  season     Season          @relation(fields: [season_id], references: [id])
  model_id   Int
  model      ModelProduction @relation(fields: [model_id], references: [id], onDelete: Cascade)
  part_type  String          @default("")
  cut_number Int             @default(0)
  color      String          @default("")
  created_at DateTime        @default(now())

  @@map("model_parts")
}

// ===== DEBTS =====
model Debt {
  id           Int           @id @default(autoincrement())
  season_id    Int
  season       Season        @relation(fields: [season_id], references: [id])
  date         String
  name         String
  total_amount Float         @default(0)
  amount_paid  Float         @default(0)
  remaining    Float         @default(0)
  created_at   DateTime      @default(now())
  payments     DebtPayment[]

  @@map("debts")
}

// ===== DEBT PAYMENT HISTORY =====
model DebtPayment {
  id             Int      @id @default(autoincrement())
  season_id      Int
  season         Season   @relation(fields: [season_id], references: [id])
  debt_id        Int
  debt           Debt     @relation(fields: [debt_id], references: [id], onDelete: Cascade)
  payment_log_id Int?
  date           String   @default("")
  amount         Float    @default(0)
  payment_method String   @default("")
  description    String   @default("")
  receiver       String   @default("")
  created_by     String   @default("")
  created_at     DateTime @default(now())

  @@map("debt_payments")
}

// ===== CLIENT ACCOUNTS =====
model ClientAccount {
  id           Int                    @id @default(autoincrement())
  season_id    Int
  season       Season                 @relation(fields: [season_id], references: [id])
  date         String
  client_name  String
  model_name   String                 @default("")
  quantity     Int                    @default(0)
  total_amount Float                  @default(0)
  amount_paid  Float                  @default(0)
  remaining    Float                  @default(0)
  notes        String                 @default("")
  created_at   DateTime               @default(now())
  payments     ClientAccountPayment[]
  invoices     ClientAccountInvoice[]

  @@map("client_accounts")
}

// ===== CLIENT ACCOUNT PAYMENT HISTORY =====
model ClientAccountPayment {
  id             Int           @id @default(autoincrement())
  season_id      Int
  season         Season        @relation(fields: [season_id], references: [id])
  account_id     Int
  account        ClientAccount @relation(fields: [account_id], references: [id], onDelete: Cascade)
  payment_log_id Int?
  date           String        @default("")
  amount         Float         @default(0)
  payment_method String        @default("")
  description    String        @default("")
  receiver       String        @default("")
  created_by     String        @default("")
  created_at     DateTime      @default(now())

  @@map("client_account_payments")
}

// ===== CLIENT ACCOUNT INVOICES (manual invoices added directly to the account) =====
model ClientAccountInvoice {
  id           Int           @id @default(autoincrement())
  season_id    Int
  season       Season        @relation(fields: [season_id], references: [id])
  account_id   Int
  account      ClientAccount @relation(fields: [account_id], references: [id], onDelete: Cascade)
  date         String        @default("")
  order_number String        @default("")
  amount       Float         @default(0)
  notes        String        @default("")
  created_by   String        @default("")
  created_at   DateTime      @default(now())

  @@map("client_account_invoices")
}

// ===== RETURNS =====
model ReturnItem {
  id            Int      @id @default(autoincrement())
  season_id     Int
  season        Season   @relation(fields: [season_id], references: [id])
  date          String
  order_number  String   @default("")
  client_name   String
  returned_by   String   @default("")
  paid_by       String   @default("")
  model_code    String   @default("")
  model_qty     Int      @default(0)
  model_color   String   @default("")
  refund_amount Float    @default(0)
  notes         String   @default("")
  created_at    DateTime @default(now())

  @@map("return_items")
}

// ===== PAYMENT LOGS =====
model PaymentLog {
  id          Int      @id @default(autoincrement())
  season_id   Int
  season      Season   @relation(fields: [season_id], references: [id])
  date        String
  type        String
  amount      Float    @default(0)
  receiver    String   @default("")
  description String   @default("")
  created_at  DateTime @default(now())

  @@map("payment_logs")
}

// ===== MARKETERS (moved from localStorage to DB) =====
model Marketer {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now())

  @@map("marketers")
}
model Asset {
  id         Int      @id @default(autoincrement())
  name       String
  value      Float
  notes      String?
  created_at DateTime @default(now())

  @@map("assets")
}

// ===== FIXED ASSETS =====
model FixedAsset {
  id                Int      @id @default(autoincrement())
  name              String
  category          String   @default("")
  purchase_date     String
  purchase_price    Float    @default(0)
  useful_life_years Int      @default(1)
  notes             String   @default("")
  created_at        DateTime @default(now())

  @@map("fixed_assets")
}

// ===== ATTENDANCE & PAYROLL: EMPLOYEES =====
model Employee {
  id             Int                @id @default(autoincrement())
  name           String
  phone          String             @default("")
  job_title      String             @default("")
  monthly_salary Float              @default(0)
  daily_hours    Float              @default(8)
  status         String             @default("active") // active | inactive
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt
  attendance     Attendance[]
  adjustments    SalaryAdjustment[]
  payroll_runs   Payroll[]

  @@map("employees")
}

// ===== ATTENDANCE & PAYROLL: ATTENDANCE RECORDS =====
model Attendance {
  id             Int      @id @default(autoincrement())
  employee_id    Int
  employee       Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  date           String
  check_in       String   @default("")
  check_out      String   @default("")
  worked_hours   Float    @default(0)
  overtime_hours Float    @default(0)
  status         String   @default("present") // present | absent | half_day | vacation | business_trip
  notes          String   @default("")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([employee_id, date])
  @@map("attendance")
}

// ===== ATTENDANCE & PAYROLL: SALARY ADJUSTMENTS (advances / deductions / bonuses) =====
model SalaryAdjustment {
  id          Int      @id @default(autoincrement())
  employee_id Int
  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  date        String
  type        String   // advance | deduction | bonus
  amount      Float    @default(0)
  reason      String   @default("")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("salary_adjustments")
}

// ===== ATTENDANCE & PAYROLL: GENERATED MONTHLY PAYROLL =====
model Payroll {
  id               Int      @id @default(autoincrement())
  employee_id      Int
  employee         Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  month            Int
  year             Int
  attendance_days  Float    @default(0)
  absent_days      Float    @default(0)
  half_days        Float    @default(0)
  worked_hours     Float    @default(0)
  overtime_hours   Float    @default(0)
  overtime_amount  Float    @default(0)
  advances         Float    @default(0)
  deductions       Float    @default(0)
  bonuses          Float    @default(0)
  base_salary      Float    @default(0)
  net_salary       Float    @default(0)
  generated_at     DateTime @default(now())

  @@unique([employee_id, month, year])
  @@map("payroll")
}

// ===== FINANCIAL SNAPSHOTS =====
model FinancialSnapshot {
  id                   Int      @id @default(autoincrement())
  season_id            Int
  season               Season   @relation(fields: [season_id], references: [id])
  snapshot_date        String
  total_current_assets Float    @default(0)
  cash                 Float    @default(0)
  fabric_assets        Float    @default(0)
  ready_stock_assets   Float    @default(0)
  accessories_assets   Float    @default(0)
  receivables          Float    @default(0)
  debts                Float    @default(0)
  created_at           DateTime @default(now())

  @@unique([season_id, snapshot_date])
  @@map("financial_snapshots")
}

// ===== PRINT ORDERS =====
model PrintOrder {
  id                   Int      @id @default(autoincrement())
  season_id            Int
  season               Season   @relation(fields: [season_id], references: [id])
  order_number         String   @default("")
  date                 String
  source_stock_id      Int      @default(0)
  source_model_code    String   @default("")
  source_product_name  String   @default("")
  source_color         String   @default("")
  quantity             Int      @default(0)
  blank_unit_cost      Float    @default(0)
  print_cost_per_piece Float    @default(0)
  final_unit_cost      Float    @default(0)
  dest_stock_id        Int      @default(0)
  dest_model_code      String   @default("")
  dest_product_name    String   @default("")
  dest_color           String   @default("")
  print_type           String   @default("")
  notes                String   @default("")
  created_by           String   @default("")
  created_at           DateTime @default(now())

  @@map("print_orders")
}

// ===== AUDIT LOG =====
model AuditLog {
  id          Int      @id @default(autoincrement())
  timestamp   DateTime @default(now())
  user_id     Int      @default(0)
  user_name   String   @default("")
  module      String
  action      String   // CREATE | UPDATE | DELETE
  record_id   String   @default("")
  before_data String?  @db.Text
  after_data  String?  @db.Text
  description String   @default("")

  @@map("audit_logs")
}


// ===== MONTHLY CHARITY (صدقة الشهر) =====
// The amount due is computed on the fly from sales.shipping_collected (never stored).
// Each payment is the SAME money movement as its linked expenses_revenues row
// (operation_type = 'صدقة', amount_out = amount); only the expense row is read by the
// financial formulas, so nothing is counted twice.
model CharityPayment {
  id              Int             @id @default(autoincrement())
  season_id       Int
  season          Season          @relation(fields: [season_id], references: [id])
  charity_month   String          // YYYY-MM the charity belongs to
  amount          Float
  payment_date    String          // YYYY-MM-DD
  payment_method  String          @default("")
  notes           String          @default("")
  expense_id      Int?            @unique
  expense         ExpenseRevenue? @relation(fields: [expense_id], references: [id], onDelete: Restrict)
  idempotency_key String          @unique
  created_by      String          @default("")
  created_at      DateTime        @default(now())

  @@index([season_id, charity_month])
  @@map("charity_payments")
}


// ===== SHIPPING COLLECTIONS (cash actually received from the shipping company) =====
// Append-only, signed ledger. sales.shipping_collected is the maintained SUM of these rows
// (kept so every existing cash/receivable formula keeps working unchanged). Changing a
// collection never rewrites history: only the difference is appended as a new row.
model ShippingCollection {
  id             Int      @id @default(autoincrement())
  season_id      Int
  season         Season   @relation(fields: [season_id], references: [id])
  sale_id        Int
  sale           Sale     @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  amount         Float    // signed: + received, − correction / reversal
  kind           String   @default("collection") // opening | collection | correction | reversal
  collected_date String   // YYYY-MM-DD the money belongs to
  date_estimated Boolean  @default(false) // true when the real receipt date was never recorded
  reference      String   @default("")
  created_by     String   @default("")
  created_at     DateTime @default(now())

  @@index([sale_id])
  @@index([season_id, collected_date])
  @@map("shipping_collections")
}

// ===== INVENTORY MOVEMENTS (cost snapshot of goods that left / came back) =====
// One row per model slot when an order's goods physically leave the factory. unit_cost is the
// recorded cost_per_piece AT THAT MOMENT, so cost of goods sold stays correct if the stock
// card's cost is edited later. Physical quantities are still derived from order statuses; this
// ledger records the cost side and the trail. Edits append SHIP_REVERSAL rows, never rewrite.
model InventoryMovement {
  id            Int      @id @default(autoincrement())
  season_id     Int
  season        Season   @relation(fields: [season_id], references: [id])
  sale_id       Int
  sale          Sale     @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  stock_id      Int?     // ready_stock row the cost came from (NULL = no matching stock card → cost unknown)
  movement_type String   // SHIP | SHIP_REVERSAL
  model_code    String
  color         String   @default("")
  qty           Int      // always positive; direction comes from movement_type
  unit_cost     Float    @default(0)
  total_cost    Float    @default(0)
  reference     String   @default("")
  created_by    String   @default("")
  created_at    DateTime @default(now())

  @@index([sale_id])
  @@index([season_id])
  @@map("inventory_movements")
}


// ===== ORDER CANCELLATIONS (audit trail of every cancellation) =====
// One row per cancel event (an order can be reopened and cancelled again). Nothing in the collection or
// inventory ledgers is deleted by a cancellation: reversal rows are appended there, and this row links them.
model OrderCancellation {
  id               Int       @id @default(autoincrement())
  season_id        Int
  season           Season    @relation(fields: [season_id], references: [id])
  sale_id          Int
  sale             Sale      @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  status_before    String
  was_shipped      Boolean   @default(false)
  disposition      String?   // see sales.cancel_disposition
  reason           String    @default("")
  goods_qty        Int       @default(0)      // pieces that had shipped
  goods_cost       Float     @default(0)      // their recorded (historical) cost
  deposit_held     Float     @default(0)      // customer deposit still held at cancellation (real cash)
  collected_held   Float     @default(0)      // shipping-company money still held at cancellation (real cash)
  linked_collection_ids String @default("[]") // JSON ids of shipping_collections rows of this order
  linked_movement_ids   String @default("[]") // JSON ids of inventory_movements rows (originals + reversals)
  restored_qty          Int    @default(0)    // pieces put back into sellable stock by this cancellation
  refund_customer_paid  Float  @default(0)    // customer refund actually paid in the same save
  repaid_shipping       Float  @default(0)    // shipping-company repayment actually paid in the same save
  revenue_reversed      Float  @default(0)    // invoice value removed from recognised sales
  receivable_reversed   Float  @default(0)    // outstanding shipping receivable removed
  linked_invoice_ids    String @default("[]") // JSON ids of client-account invoices reversed
  created_by       String    @default("")
  created_at       DateTime  @default(now())
  reopened_at      DateTime?

  @@index([sale_id])
  @@index([season_id])
  @@map("order_cancellations")
}


// ===== CASH RECONCILIATION =====
// The cash ledger itself is DERIVED from the existing records (deposits, collections, expenses, refunds, payments).
// These two tables only hold what cannot be derived: a physical count, and explicit, reasoned adjustments / the opening balance.
model CashCount {
  id               Int      @id @default(autoincrement())
  season_id        Int
  season           Season   @relation(fields: [season_id], references: [id])
  count_date       String
  counted_amount   Float
  calculated_amount Float
  difference       Float
  note             String   @default("")
  idempotency_key  String   @unique
  created_by       String   @default("")
  created_at       DateTime @default(now())

  @@index([season_id, count_date])
  @@map("cash_counts")
}

model CashAdjustment {
  id               Int      @id @default(autoincrement())
  season_id        Int
  season           Season   @relation(fields: [season_id], references: [id])
  kind             String   // opening | adjustment
  amount           Float    // signed: + adds cash, − removes cash
  entry_date       String
  reason           String
  idempotency_key  String   @unique
  created_by       String   @default("")
  created_at       DateTime @default(now())

  @@index([season_id, kind])
  @@map("cash_adjustments")
}
